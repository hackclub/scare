# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma — Postgres connection string (ask for the dev database's URL)
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=verify-full"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""

# Optional: separate key for encrypting stored OAuth tokens (defaults to AUTH_SECRET)
# TOKEN_ENCRYPTION_KEY=""

# Hack Club Auth — create an OAuth app at https://auth.hackclub.com
# Redirect URI: http://localhost:3000/api/auth/callback/hackclub
AUTH_HACKCLUB_ID=""
AUTH_HACKCLUB_SECRET=""

# Hackatime — create an OAuth app at https://hackatime.hackclub.com/oauth/applications
# Scopes: profile read · Redirect URI: http://localhost:3000/api/auth/callback/hackatime
HACKATIME_CLIENT_ID=""
HACKATIME_CLIENT_SECRET=""

# Production only: the public site URL (used for OAuth redirect URIs)
# AUTH_URL="https://scare.hackclub.com"

# Admin dashboard (/admin): comma-separated Hack Club identity IDs. Empty or unset = no admins.
# Find yours on /platform/profile ("Identity").
ADMIN_IDENTITY_IDS="ident!JLfMKL"

# Airtable: shipped projects go to the program base's "YSWS Project Submission" table.
# Personal access token scoped to that one base (data.records:read/write, schema.bases:read).
AIRTABLE_PAT=""
AIRTABLE_BASE_ID="appb6dZnzzPaERiag"
AIRTABLE_TABLE_ID="tblL2k1AGLrLCdPQ2"

# Ari review platform (program settings in Ari)
ARI_PROGRAM_ID=""
ARI_SIGNING_SECRET=""
ARI_WEBHOOK_SECRET=""
